// À coller dans la console Firebase : Firestore Database → Rules → Publish.
// Chaque utilisateur ne peut lire ou modifier que ses propres données. Les
// vérifications ci-dessous empêchent aussi l'enregistrement de structures ou
// de valeurs manifestement anormales, même en dehors de l'application.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function optionalText(data, field, maxLength) {
      return !(field in data) || validText(data[field], maxLength);
    }

    function optionalNullableText(data, field, maxLength) {
      return !(field in data) || data[field] == null || validText(data[field], maxLength);
    }

    function optionalNumber(data, field, min, max) {
      return !(field in data) || (data[field] is number
        && data[field] >= min && data[field] <= max);
    }

    function optionalNullableNumber(data, field, min, max) {
      return !(field in data) || data[field] == null || (data[field] is number
        && data[field] >= min && data[field] <= max);
    }

    function optionalBoolean(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validRecord(data) {
      return data.keys().hasOnly([
          'type', 'date', 'odometer', 'liters', 'cost', 'fullTank', 'notes',
          'description', 'category', 'vendor', 'attachments', 'name',
          'locationText', 'lat', 'lng', 'locationSource', 'distanceFromHomeKm'
        ])
        && data.keys().hasAll(['type', 'date'])
        && data.type in ['fuel', 'odometer', 'place', 'maintenance', 'part', 'renovation']
        && validDate(data.date)
        && optionalNullableNumber(data, 'odometer', 0, 2000000)
        && optionalNullableNumber(data, 'liters', 0, 10000)
        && optionalNullableNumber(data, 'cost', 0, 1000000)
        && optionalBoolean(data, 'fullTank')
        && optionalText(data, 'notes', 5000)
        && optionalText(data, 'description', 500)
        && optionalText(data, 'category', 100)
        && optionalText(data, 'vendor', 200)
        && optionalText(data, 'name', 300)
        && optionalText(data, 'locationText', 1000)
        && optionalNullableText(data, 'locationSource', 50)
        && optionalNullableNumber(data, 'lat', -90, 90)
        && optionalNullableNumber(data, 'lng', -180, 180)
        && optionalNullableNumber(data, 'distanceFromHomeKm', 0, 100000)
        // Firebase Rules ne permet pas de parcourir chaque élément d'une liste.
        // La taille de la liste est donc limitée ici; chaque fichier est
        // contrôlé séparément par les règles Storage.
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 20));
    }

    function validVehicle(data) {
      return data.keys().hasOnly([
          'nickname', 'make', 'model', 'year', 'purchaseDate',
          'purchaseOdometer', 'purchasePrice', 'homeLocationText', 'homeLat', 'homeLng'
        ])
        && optionalText(data, 'nickname', 100)
        && optionalText(data, 'make', 100)
        && optionalText(data, 'model', 100)
        && optionalNullableNumber(data, 'year', 1886, 2100)
        && (!(('purchaseDate') in data) || data.purchaseDate == '' || validDate(data.purchaseDate))
        && optionalNullableNumber(data, 'purchaseOdometer', 0, 2000000)
        && optionalNullableNumber(data, 'purchasePrice', 0, 10000000)
        && optionalText(data, 'homeLocationText', 1000)
        && optionalNullableNumber(data, 'homeLat', -90, 90)
        && optionalNullableNumber(data, 'homeLng', -180, 180);
    }

    match /users/{uid}/records/{recordId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validRecord(request.resource.data);
    }

    match /users/{uid}/meta/vehicle {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validVehicle(request.resource.data);
    }
  }
}
