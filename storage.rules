// À coller dans la console Firebase : Storage → Rules → Publish.
// Même principe que firestore.rules : chaque utilisateur ne peut lire/écrire
// que ses propres fichiers, sous /users/{son-uid}/ — personne d'autre, même
// connecté, ne peut y accéder. La limite de taille doit rester alignée avec
// MAX_FILE_SIZE dans js/attachments.js.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Pour un ajout ou une modification, on limite la taille à 10 Mo.
      // Lors d'une suppression, request.resource n'existe plus : cette action
      // est donc autorisée séparément, toujours uniquement au propriétaire.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
